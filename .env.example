# Core application settings
ENVIRONMENT=development
PORT=8000
APP_NAME=CVantage API
LOG_LEVEL=INFO
SWAGGER_ENABLED=true
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
AUTH_ACCESS_TOKEN_SECRET=dev-auth-secret-change-me
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_JWT_ISSUER=cvantage-api
AUTH_JWT_AUDIENCE=cvantage-clients
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_REFRESH_COOKIE_NAME=cv_refresh_token
AUTH_COOKIE_SECURE=true
OAUTH_CALLBACK_BASE_URL=http://localhost:8000/api/v1/auth/oauth
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_LINKEDIN_CLIENT_ID=
OAUTH_LINKEDIN_CLIENT_SECRET=
MAIL_DRIVER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@cvantage.local

# MongoDB
MONGODB_URI=mongodb://localhost:27017/cvantage-py
MONGODB_DB_NAME=cvantage

# Health readiness thresholds
READY_MIN_DISK_FREE_MB=128
READY_MIN_MEMORY_AVAILABLE_MB=128

# Security middleware baseline
CORS_ORIGINS=http://localhost:5173
MAX_REQUEST_BODY_BYTES=2000000
RATE_LIMIT_GLOBAL=200/minute
RATE_LIMIT_AUTH=60/minute
RATE_LIMIT_UPLOAD=20/minute
RATE_LIMIT_ANALYSIS=10/minute
SHUTDOWN_TIMEOUT_MS=10000
AUTH_LOCKOUT_FAILURE_THRESHOLD=5
AUTH_LOCKOUT_BACKOFF_BASE_SECONDS=30
AUTH_LOCKOUT_BACKOFF_MAX_SECONDS=900

MASTER_ENCRYPTION_KEY=
OPENAI_API_KEY=

# SPA serving (single-server production serves frontend/dist on the API port)
SERVE_SPA=
SPA_DIST_DIR=../frontend/dist

# LLM tuning & cost guards (issue #54)
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=2048
ANALYSIS_MAX_JD_CHARS=50000
ANALYSIS_MAX_RESUME_CHARS=200000
MAX_CONCURRENT_ANALYSES_PER_USER=3

# LLM observability (all optional — zero overhead when unset)
# Error tracking (Sentry) — env-gated; leave SENTRY_DSN empty to disable entirely.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_RELEASE=

# Distributed tracing (OpenTelemetry) — env-gated; needs OTEL_ENABLED=true + an endpoint.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=cvantage-api

# LangSmith: LangChain reads these from the environment when tracing is enabled.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGSMITH_ENDPOINT=
# Langfuse: optional callback handler (requires the `langfuse` package installed).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/uploads
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
