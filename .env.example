# Core application settings
ENVIRONMENT=development
PORT=8000
APP_NAME=CVantage API
LOG_LEVEL=INFO
SWAGGER_ENABLED=true
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
AUTH_ACCESS_TOKEN_SECRET=dev-auth-secret-change-me
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_JWT_ISSUER=cvantage-api
AUTH_JWT_AUDIENCE=cvantage-clients
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_REFRESH_COOKIE_NAME=cv_refresh_token
AUTH_COOKIE_SECURE=true
OAUTH_CALLBACK_BASE_URL=http://localhost:8000/api/v1/auth/oauth
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_LINKEDIN_CLIENT_ID=
OAUTH_LINKEDIN_CLIENT_SECRET=
MAIL_DRIVER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@cvantage.local

# MongoDB
MONGODB_URI=mongodb://localhost:27017/cvantage-py
MONGODB_DB_NAME=cvantage

# Health readiness thresholds
READY_MIN_DISK_FREE_MB=128
READY_MIN_MEMORY_AVAILABLE_MB=128

# Security middleware baseline
CORS_ORIGINS=http://localhost:5173
MAX_REQUEST_BODY_BYTES=2000000
RATE_LIMIT_GLOBAL=200/minute
RATE_LIMIT_AUTH=60/minute
RATE_LIMIT_UPLOAD=20/minute
RATE_LIMIT_ANALYSIS=10/minute
SHUTDOWN_TIMEOUT_MS=10000
AUTH_LOCKOUT_FAILURE_THRESHOLD=5
AUTH_LOCKOUT_BACKOFF_BASE_SECONDS=30
AUTH_LOCKOUT_BACKOFF_MAX_SECONDS=900

STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/uploads
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
